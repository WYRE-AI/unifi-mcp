# UniFi Cloud Site Manager API key (X-API-Key) for stdio and for HTTP only
# when AUTH_MODE=env. Generate at unifi.ui.com -> Settings -> API Keys.
# Documented by Ubiquiti as read-only account-wide. The gateway Compose
# service does not load this. Do not add it to that service's environment
# or via env_file. Gateway mode requires the X-UniFi-Api-Key header.
UNIFI_API_KEY=

# Transport: stdio (default) or http
MCP_TRANSPORT=stdio
MCP_HTTP_PORT=8080
# Bind address. With a real CONDUIT_S2S_SECRET, MCP_HTTP_HOST is honored and
# an unset value stays 0.0.0.0 (the historical bind). The image and Compose
# set 0.0.0.0 inside the container and publish the host port on 127.0.0.1.
# With no secret, MCP_ALLOW_INSECURE_DEV=1 ignores this and binds 127.0.0.1.
# MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty or a known placeholder (changeme, secret,
# replace-me, and the other example values). Generate with:
#   openssl rand -hex 32
# Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without
# CONDUIT_S2S_SECRET. The server logs a warning, does not check X-Gateway-S2S,
# and binds 127.0.0.1 only (a non-loopback MCP_HTTP_HOST is overridden).
# A known placeholder secret still refuses to start when this is set.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-UniFi-Api-Key header; no env fallback). The container image and Compose
# service set gateway. Stdio ignores this and reads UNIFI_API_KEY.
# AUTH_MODE=env

# Log level: debug, info, warn, error
LOG_LEVEL=info
